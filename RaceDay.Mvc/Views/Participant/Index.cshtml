@model List<RaceDay.Api.DTOs.EventResponseDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Upcoming Events</h2>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">There are no upcoming events at the moment.</div>
        </div>
    }

    @foreach (var ev in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                @if (!string.IsNullOrEmpty(ev.BannerUrl))
                {
                    <img src="@ev.BannerUrl" class="card-img-top" alt="@ev.Name" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px;">
                        <h5>No Image Available</h5>
                    </div>
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@ev.Name</h5>
                    <p class="text-muted mb-2">
                         @ev.Date.ToString("dd MMM yyyy") <br />
                         @ev.Location <br />
                         @ev.Distance km (@ev.EventType)
                    </p>
                    <p class="card-text flex-grow-1">@ev.Description</p>

                    <form asp-action="Enrol" method="post" class="mt-3">
                        <input type="hidden" name="eventId" value="@ev.Id" />
                        <div class="mb-2">
                            <label class="form-label fw-bold">Select Category:</label>
                            <select name="categoryId" class="form-select" required>
                                <option value="">-- Choose a Category --</option>
                                @foreach (var cat in ev.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name (@cat.Distance km)</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Enrol Now</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
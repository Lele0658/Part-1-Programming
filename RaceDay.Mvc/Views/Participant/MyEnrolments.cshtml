@model List<RaceDay.Api.DTOs.EnrolmentResponseDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mb-4">My Enrolments</h2>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Date Enrolled</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">You have not enrolled in any events yet.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td class="fw-bold">@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td>@item.EnrolledDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.Status == "Confirmed")
                            {
                                <span class="badge bg-success px-3 py-2">✔ Confirmed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3 py-2">⏳ Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
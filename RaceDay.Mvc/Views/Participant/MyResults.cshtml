@model List<RaceDay.Api.DTOs.ResultResponseDto>
@{
    ViewData["Title"] = "My Results";
}

<h2 class="mb-4">My Race Results</h2>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">No results available yet. Results are published after the event concludes.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td class="fw-bold">@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td>
                            <span class="badge bg-secondary fs-6">
                                @item.FinishTime.ToString(@"hh\:mm\:ss")
                            </span>
                        </td>
                        <td>
                            <span class="fw-bold text-primary">
                                @item.Position
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
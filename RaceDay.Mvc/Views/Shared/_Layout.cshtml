<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />

    <!-- Custom RaceDay Theme -->
    <style>
            :root {
                --raceday-red: #e63946;
                --raceday-dark: #1d3557;
                --raceday-light: #f1faee;
            }

            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .navbar-raceday {
                background-color: var(--raceday-dark) !important;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

                .navbar-raceday .navbar-brand {
                    color: white !important;
                    font-weight: 800;
                    font-size: 1.5rem;
                    letter-spacing: 1px;
                }

                .navbar-raceday .nav-link {
                    color: rgba(255, 255, 255, 0.85) !important;
                    font-weight: 500;
                    transition: color 0.2s;
                }

                    .navbar-raceday .nav-link:hover {
                        color: var(--raceday-red) !important;
                    }

            .btn-primary {
                background-color: var(--raceday-red);
                border-color: var(--raceday-red);
            }

                .btn-primary:hover {
                    background-color: #d62839;
                    border-color: #d62839;
                }

            .footer-raceday {
                background-color: white;
                border-top: 3px solid var(--raceday-red);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-raceday">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"> RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var role = Context.Session.GetString("UserRole");
                            var fullName = Context.Session.GetString("FullName");
                            var isLoggedIn = !string.IsNullOrEmpty(role);
                        }

                        @if (isLoggedIn)
                        {
                            if (role == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="ManageEvents">Manage Events</a>
                                </li>
                            }
                            else if (role == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="Index">Upcoming Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-warning fw-bold">Hello, @fullName</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-raceday footer text-muted mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - RaceDay - The Ultimate Event Platform
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
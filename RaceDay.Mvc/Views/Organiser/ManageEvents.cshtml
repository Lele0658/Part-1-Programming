@model List<RaceDay.Api.DTOs.EventResponseDto>
@{ ViewData["Title"] = "Manage Events"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Events</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">+ Create New Event</a>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Event Name</th>
            <th>Date</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var ev in Model) {
            <tr>
                <td>@ev.Name</td>
                <td>@ev.Date.ToShortDateString()</td>
                <td>@ev.Location</td>
                <td>
                    <a asp-action="ViewEnrolments" asp-route-id="@ev.Id" class="btn btn-sm btn-info text-white">Enrolments</a>
                    <!-- Add Edit/Delete buttons here if you have time -->
                </td>
            </tr>
        }
    </tbody>
</table>

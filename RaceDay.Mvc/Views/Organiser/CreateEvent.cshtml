@model RaceDay.Api.DTOs.EventDto
@{ ViewData["Title"] = "Create Event"; }

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h4>Create New Event</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label class="form-label">Event Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date</label>
                            <input asp-for="Date" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Distance (km)</label>
                            <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Event Type (run/walk/cycle)</label>
                            <input asp-for="EventType" class="form-control" required />
                        </div>
                    </div>

                    <!-- AZURE BLOB UPLOAD -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Event Banner Image</label>
                        <input type="file" name="bannerFile" class="form-control" accept="image/*" />
                        <small class="text-muted">This will be uploaded to Azure Blob Storage.</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create Event</button>
                </form>
            </div>
        </div>
    </div>
</div>